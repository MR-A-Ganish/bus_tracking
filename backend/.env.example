DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=smart_bus_system
SECRET_KEY=change-this-to-a-long-random-string

# "prefer" works for both local Postgres and managed cloud hosts (encrypts
# when the server supports TLS, falls back to plain when it doesn't).
DB_SSLMODE=prefer

# Managed Postgres hosts (Render, Supabase, etc.) usually give you one
# connection string instead of separate host/port/user/password - if set,
# this takes priority over all the DB_* vars above.
# DATABASE_URL=postgresql://user:password@host:port/dbname

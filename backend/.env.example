DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_bus_system
SECRET_KEY=change-this-to-a-long-random-string

# Set to "true" only when connecting to a managed cloud MySQL (e.g. Aiven)
# that requires TLS. Leave "false" for a local MySQL install.
DB_USE_SSL=false
